# This file is a placeholder for environment variables required to run this project.
# Currently, there are no environment variables needed.

# Example of what future variables might look like:
# NEXT_PUBLIC_API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here
# SECRET_KEY=your_secret_key_here

# Password for protected pages/routes
PAGE_ACCESS_PASSWORD=password

# Google Maps JavaScript API key — required for the clustering demo on /work/google-maps-clustering
# Restrict the key to your domain in the Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Map ID — required for the clustering demo styling/configuration
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id_here

# Enable GTM/UserWay on localhost for development testing only
# Keep this false in production environments
NEXT_PUBLIC_ENABLE_GTM_DEV=false
